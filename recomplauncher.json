{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "The Simpsons: Bart's Nightmare Recomp",
  "repo": "mpolizel/TSBNSNESRecomp",
  "game": {
    "kind": "iso",
    "label": "Your ROM of The Simpsons: Bart's Nightmare for the Super NES, USA release (.sfc or .smc, not zipped). The first start recompiles the game from it, which takes a few minutes.",
    "dumps": [
      {
        "name": "USA",
        "size": 1048576,
        "crc32": "ed1c03c2"
      }
    ]
  },
  "start": {
    "program": [
      "TheSimpsonsBartsNightmareSNESRecomp.exe"
    ],
    "args": [
      "--launcher",
      "--rom",
      "{game}"
    ]
  },
  "saves": [
    "{install}/build/saves",
    "{install}/build/config.ini",
    "{install}/build/keybinds.ini"
  ],
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [
        {
          "path": "{install}/build/config.ini"
        }
      ]
    }
  ],
  "folders": {
    "saves": [
      {
        "path": "{install}/build/saves"
      }
    ],
    "logs": [
      {
        "path": "{install}/build",
        "if": "{install}/build/TheSimpsonsBartsNightmareSNESRecomp.log"
      },
      {
        "path": "{install}"
      }
    ],
    "backups": [
      {
        "path": "{install}/save-backups"
      }
    ]
  },
  "settings": [
    {
      "id": "window",
      "label": "Window",
      "help": "Fullscreen fills your screen and lets you switch apps quickly. Exclusive gives the game the screen to itself.",
      "choices": [
        {
          "label": "Windowed",
          "set": {
            "Graphics/Fullscreen": "0"
          }
        },
        {
          "label": "Fullscreen",
          "set": {
            "Graphics/Fullscreen": "1"
          }
        },
        {
          "label": "Exclusive",
          "set": {
            "Graphics/Fullscreen": "2"
          }
        }
      ],
      "defaults": {
        "Graphics/Fullscreen": "0"
      }
    },
    {
      "id": "window_scale",
      "label": "Window size",
      "help": "How many times the console's 256x224 picture the window is.",
      "choices": [
        {
          "label": "2x",
          "set": {
            "Graphics/WindowScale": "2"
          }
        },
        {
          "label": "3x",
          "set": {
            "Graphics/WindowScale": "3"
          }
        },
        {
          "label": "4x",
          "set": {
            "Graphics/WindowScale": "4"
          }
        },
        {
          "label": "5x",
          "set": {
            "Graphics/WindowScale": "5"
          }
        }
      ],
      "defaults": {
        "Graphics/WindowScale": "3"
      },
      "when": {
        "Graphics/Fullscreen": "0"
      }
    },
    {
      "id": "aspect",
      "label": "Picture shape",
      "help": "Keep the console's shape, or stretch the picture to fill the window.",
      "choices": [
        {
          "label": "Console's shape",
          "set": {
            "Graphics/IgnoreAspectRatio": "0"
          }
        },
        {
          "label": "Stretch",
          "set": {
            "Graphics/IgnoreAspectRatio": "1"
          }
        }
      ],
      "defaults": {
        "Graphics/IgnoreAspectRatio": "0"
      }
    },
    {
      "id": "renderer",
      "label": "Renderer",
      "help": "OpenGL runs the shaders. Direct3D 11 is often smoother on Intel graphics.",
      "choices": [
        {
          "label": "OpenGL",
          "set": {
            "Graphics/Renderer": "opengl"
          }
        },
        {
          "label": "Direct3D 11",
          "set": {
            "Graphics/Renderer": "direct3d11"
          }
        },
        {
          "label": "Direct3D 12",
          "set": {
            "Graphics/Renderer": "direct3d12"
          }
        },
        {
          "label": "Vulkan",
          "set": {
            "Graphics/Renderer": "vulkan"
          }
        }
      ],
      "defaults": {
        "Graphics/Renderer": "opengl"
      }
    },
    {
      "id": "shader",
      "label": "Shader",
      "help": "A look for the picture. None is the console's own pixels; shaders switch the renderer to OpenGL.",
      "choices": [
        {
          "label": "None",
          "set": {
            "Graphics/Shader": ""
          }
        },
        {
          "label": "Scanlines",
          "set": {
            "Graphics/Shader": "assets/shaders/Scanlines/Classic.glslp"
          }
        },
        {
          "label": "CRT",
          "set": {
            "Graphics/Shader": "assets/shaders/CRT/Lottes.glslp"
          }
        },
        {
          "label": "Curved CRT",
          "set": {
            "Graphics/Shader": "assets/shaders/CRT/Geom (curved).glslp"
          }
        },
        {
          "label": "ScaleFX",
          "set": {
            "Graphics/Shader": "assets/shaders/Upscaler/ScaleFX.glslp"
          }
        },
        {
          "label": "NNEDI3",
          "set": {
            "Graphics/Shader": "assets/shaders/Upscaler/NNEDI3 (neural).glslp"
          }
        }
      ],
      "defaults": {
        "Graphics/Shader": ""
      }
    },
    {
      "id": "sprites",
      "label": "Sprite limit",
      "help": "The console hides sprites when too many share a line, which makes them flicker. Off shows them all.",
      "choices": [
        {
          "label": "Off",
          "set": {
            "Graphics/NoSpriteLimits": "1"
          }
        },
        {
          "label": "Like the console",
          "set": {
            "Graphics/NoSpriteLimits": "0"
          }
        }
      ],
      "defaults": {
        "Graphics/NoSpriteLimits": "1"
      }
    },
    {
      "id": "audio",
      "label": "Sound",
      "help": "Turn the game's sound and music off or on.",
      "choices": [
        {
          "label": "On",
          "set": {
            "Sound/EnableAudio": "1"
          }
        },
        {
          "label": "Off",
          "set": {
            "Sound/EnableAudio": "0"
          }
        }
      ],
      "defaults": {
        "Sound/EnableAudio": "1"
      }
    },
    {
      "id": "volume",
      "label": "Volume",
      "help": "The game's volume, from 0 to 100.",
      "slider": {
        "key": "Sound/Volume",
        "min": 0,
        "max": 100,
        "step": 5,
        "format": "%d"
      },
      "defaults": {
        "Sound/Volume": "100"
      },
      "when": {
        "Sound/EnableAudio": "1"
      }
    },
    {
      "id": "background_input",
      "label": "Controller in the background",
      "advanced": true,
      "help": "Let the game read the controller while another window is in front. Off keeps launcher overlays from moving the game.",
      "choices": [
        {
          "label": "Off",
          "set": {
            "General/BackgroundInput": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "General/BackgroundInput": "1"
          }
        }
      ],
      "defaults": {
        "General/BackgroundInput": "0"
      }
    }
  ],
  "actions": [
    {
      "id": "saves",
      "label": "Save states",
      "help": "Your save states (the cartridge has no battery save).",
      "open": "saves"
    },
    {
      "id": "backups",
      "label": "Save backups",
      "help": "Copies of your saves the game's own updater makes before installing a new version.",
      "open": "backups"
    }
  ],
  "prepare": {
    "program": [
      "TheSimpsonsBartsNightmareSNESRecomp.exe"
    ],
    "args": [
      "--prepare",
      "--rom",
      "{game}"
    ],
    "label": "Recompiling the game from your ROM. A few minutes; the first time it also gets the build tools.",
    "timeout": 3600
  },
  "exit_codes": {
    "1": "The game couldn't use your ROM. Pick your copy again on the game's page.",
    "3": "This ROM isn't the USA release of The Simpsons: Bart's Nightmare (CRC32 ed1c03c2). Pick that copy on the game's page.",
    "4": "The build tools couldn't be set up. Check your internet connection and set the game up again.",
    "5": "Building the game failed. Its log is build/snesrecomp_rebuild.log in the game's folder."
  },
  "looks": {
    "allowed": false,
    "reason": "This recomp has its own scanline, CRT and upscaler shaders: pick one under Shader in its settings."
  }
}
