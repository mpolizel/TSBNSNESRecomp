+/* -- Headless setup (--prepare) --------------------------------------------
+ * The same steps as the launcher's Generate & rebuild, for a caller that
+ * shows its own progress (RecompLauncher's setup screen): no window, one
+ * "progress <0..1> <text>" line per step on stdout, an exit code per outcome.
+ * Windows builds in place here (the launcher defers its build to a console
+ * helper because it relaunches itself; this process just waits). */
+typedef struct { float lo, hi; } PrepareSpan;
+
+static void prepare_print(float pct, const char* text) {
+    if (pct < 0.0f) pct = 0.0f;
+    if (pct > 1.0f) pct = 1.0f;
+    printf("progress %.2f %s\n", pct, text && text[0] ? text : "");
+    fflush(stdout);
+}
+
+static void prepare_progress(void* ctx, float pct, const char* message) {
+    const PrepareSpan* s = (const PrepareSpan*)ctx;
+    if (pct < 0.0f) return;   /* log lines: the step's own log keeps them */
+    prepare_print(s->lo + (s->hi - s->lo) * pct, message);
+}
+
+#if defined(_WIN32)
+static int prepare_build_win(char* err, size_t cap) {
+    char script[1100];
+    if (!join_path(script, sizeof(script), g_build_dir, "recomp_prepare_build.cmd")) {
+        snprintf(err, cap, "Failed to form the build script path.");
+        return 0;
+    }
+    mkdir_p(g_build_dir);
+    FILE* f = fopen(script, "wb");
+    if (!f) { snprintf(err, cap, "Failed to write %s", script); return 0; }
+    fprintf(f, "@echo off\r\nsetlocal EnableExtensions\r\n");
+    bat_write_set(f, "CMAKE", g_cmake);
+    bat_write_set(f, "BUILD_DIR", g_build_dir);
+    bat_write_set(f, "ROOT", g_project_root);
+    bat_write_set(f, "TARGET", g_cmake_target);
+    bat_write_set(f, "PACK", g_toolchain_root);
+    fprintf(f,
+            "if exist \"%%PACK%%\\env.bat\" call \"%%PACK%%\\env.bat\" >nul\r\n"
+            "cd /d \"%%ROOT%%\"\r\n"
+            "if not exist \"%%BUILD_DIR%%\\CMakeCache.txt\" (\r\n"
+            "  powershell -NoProfile -Command \"Get-ChildItem -Recurse -File "
+            "-Exclude build | Where-Object { $_.LastWriteTime -gt (Get-Date) } | "
+            "ForEach-Object { $_.LastWriteTime = Get-Date }\"\r\n"
+            "  \"%%CMAKE%%\" -S \"%%ROOT%%\" -B \"%%BUILD_DIR%%\" -G Ninja "
+            "-DCMAKE_BUILD_TYPE=Release || exit /b 1\r\n"
+            ")\r\n"
+            "\"%%CMAKE%%\" --build \"%%BUILD_DIR%%\" --parallel --target \"%%TARGET%%\"\r\n"
+            "exit /b %%errorlevel%%\r\n");
+    fclose(f);
+
+    char cmd[1400];
+    snprintf(cmd, sizeof(cmd), "cmd.exe /C \"\"%s\"\"", script);
+    SECURITY_ATTRIBUTES sa = { sizeof(sa), NULL, TRUE };
+    HANDLE rd = NULL, wr = NULL;
+    if (!CreatePipe(&rd, &wr, &sa, 0)) { snprintf(err, cap, "CreatePipe failed"); return 0; }
+    SetHandleInformation(rd, HANDLE_FLAG_INHERIT, 0);
+    STARTUPINFOA si;
+    PROCESS_INFORMATION pi;
+    memset(&si, 0, sizeof(si));
+    memset(&pi, 0, sizeof(pi));
+    si.cb = sizeof(si);
+    si.dwFlags = STARTF_USESTDHANDLES;
+    si.hStdOutput = wr;
+    si.hStdError = wr;
+    si.hStdInput = GetStdHandle(STD_INPUT_HANDLE);
+    if (!CreateProcessA(NULL, cmd, NULL, NULL, TRUE, CREATE_NO_WINDOW, NULL,
+                        g_project_root, &si, &pi)) {
+        CloseHandle(rd);
+        CloseHandle(wr);
+        snprintf(err, cap, "Failed to start the build (%lu)", (unsigned long)GetLastError());
+        return 0;
+    }
+    CloseHandle(wr);
+    char log_path[1100];
+    FILE* log = join_path(log_path, sizeof(log_path), g_build_dir, "snesrecomp_rebuild.log")
+                    ? fopen(log_path, "ab") : NULL;
+    char line[2048];
+    size_t len = 0;
+    char buf[4096];
+    DWORD n = 0;
+    while (ReadFile(rd, buf, sizeof(buf), &n, NULL) && n > 0) {
+        if (log) fwrite(buf, 1, n, log);
+        for (DWORD i = 0; i < n; ++i) {
+            char c = buf[i];
+            if (c == '\r') continue;
+            if (c != '\n' && len + 1 < sizeof(line)) { line[len++] = c; continue; }
+            line[len] = '\0';
+            unsigned done = 0, total = 0;
+            if (sscanf(line, "[%u/%u]", &done, &total) == 2 && total)
+                prepare_print(0.60f + 0.38f * (float)done / (float)total, "Compiling the game");
+            len = 0;
+        }
+    }
+    if (log) fclose(log);
+    CloseHandle(rd);
+    WaitForSingleObject(pi.hProcess, INFINITE);
+    DWORD code = 1;
+    GetExitCodeProcess(pi.hProcess, &code);
+    CloseHandle(pi.hThread);
+    CloseHandle(pi.hProcess);
+    if (code != 0) {
+        snprintf(err, cap, "The build failed (exit %lu); see build\\snesrecomp_rebuild.log",
+                 (unsigned long)code);
+        return 0;
+    }
+    return 1;
+}
+#endif
+
+int snesrecomp_codegen_host_prepare_headless(const char* display_name,
+                                             const char* rom) {
+    static RecompLauncherCGameInfo gi;
+    char err[1024] = "";
+    g_headless = 1;
+    if (!rom || !rom[0]) {
+        fprintf(stderr, "prepare: no ROM (pass --rom <path>)\n");
+        return 2;
+    }
+    /* Prepare builds; it never starts the game. */
+#if defined(_WIN32)
+    _putenv_s("SNESRECOMP_NO_HANDOFF", "1");
+#else
+    setenv("SNESRECOMP_NO_HANDOFF", "1", 1);
+#endif
+    memset(&gi, 0, sizeof(gi));
+    prepare_print(0.0f, "Checking the setup pack");
+    snesrecomp_codegen_host_autowire(&gi, display_name);
+    if (!g_ready || !g_build_dir[0]) {
+        fprintf(stderr, "prepare: this folder is not a setup pack\n");
+        return 4;
+    }
+    char why[256];
+    if (!resolve_tools(why, sizeof(why))) {
+        PrepareSpan s = { 0.02f, 0.30f };
+        prepare_print(0.02f, "Getting the build tools (one time per PC)");
+        if (!host_ensure_toolchain_with_progress(1, NULL, err, sizeof(err),
+                                                 prepare_progress, &s)) {
+            fprintf(stderr, "prepare: %s\n", err);
+            return 4;
+        }
+    }
+    {
+        PrepareSpan s = { 0.30f, 0.58f };
+        char out[1100] = "";
+        prepare_print(0.30f, "Recompiling the game from your ROM");
+        if (!host_prepare_generate(rom, out, sizeof(out), err, sizeof(err),
+                                   prepare_progress, &s)) {
+            fprintf(stderr, "prepare: %s\n", err);
+            return strstr(err, "ROM verification failed") ? 3 : 5;
+        }
+    }
+    prepare_print(0.60f, "Compiling the game");
+#if defined(_WIN32)
+    if (!prepare_build_win(err, sizeof(err))) {
+        fprintf(stderr, "prepare: %s\n", err);
+        return 5;
+    }
+#else
+    {
+        PrepareSpan s = { 0.60f, 0.98f };
+        char exe[1100];
+        if (!host_rebuild_game(rom, exe, sizeof(exe), err, sizeof(err),
+                               prepare_progress, &s)) {
+            fprintf(stderr, "prepare: %s\n", err);
+            return 5;
+        }
+    }
+#endif
+    if (!path_is_file(g_exe_path)) {
+        fprintf(stderr, "prepare: the build did not produce %s\n", g_exe_path);
+        return 5;
+    }
+    snesrecomp_rom_cache_write(rom);
+    prepare_print(1.0f, "Ready to play");
+    return 0;
+}
