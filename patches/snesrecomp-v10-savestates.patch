+/* Rebuild the per-clock S-DSP (clk) and the canonical timing fields from the
+ * sample-step model's state, for a savestate older than v11 (which carried
+ * only that model). See dsp_clock.c. */
+void dsp_clockImportLegacy(Dsp* dsp);
