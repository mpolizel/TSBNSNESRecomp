diff --git a/runner/src/snes/dsp_clock.c b/runner/src/snes/dsp_clock.c
index f9d7e878..8cf5cd55 100644
--- a/runner/src/snes/dsp_clock.c
+++ b/runner/src/snes/dsp_clock.c
@@ -390,3 +390,102 @@ void dsp_clockWrite(Dsp *dsp, uint8_t adr, uint8_t val) {
   else if (adr == R_KON) c->konNew = val;
   else if (adr == R_ENDX) { c->endxBuf = 0; dsp_publish(dsp, R_ENDX, 0); }
 }
+
+/* ── v10 savestates ───────────────────────────────────────────────────────
+ * A state written before the per-clock S-DSP carries only the sample-step
+ * model (Dsp.ram .. output, the `channel` voices). Everything the per-clock
+ * model needs is there or derivable, except the phases nothing recorded:
+ * the shared rate counter and the 32-clock step, which start at their reset
+ * values (an envelope step lands a few samples off; nothing is skipped).
+ *
+ * Voices. The old decoder keeps the current BRR block as 16 samples at
+ * decodeBuffer[3..18] (the previous block's last three at [0..2]) and has
+ * already moved decodeOffset to the next block, whose loop redirect it
+ * applies when it gets there (previousFlags). Its interpolation window at
+ * pitchCounter is decodeBuffer[s..s+3], s = pitchCounter >> 12, i.e. block
+ * samples s-3..s, with the same 8-bit Gaussian fraction. The per-clock
+ * model reads the window from the oldest of three 4-sample groups in its
+ * ring (bufPos) at pos >> 12 and decodes the next group when pos passes
+ * 0x4000. Samples are the same values, held one bit higher (x2). */
+static uint16_t legacy_loop_adr(const Dsp *dsp, int v) {
+  uint16_t p = (uint16_t)(dsp->dirPage + 4 * dsp->channel[v].srcn);
+  return (uint16_t)(ram8(dsp, (uint16_t)(p + 2)) | ram8(dsp, (uint16_t)(p + 3)) << 8);
+}
+
+/* Decode the voice's next 4 samples, then advance as step4 does. */
+static void legacy_decode_group(Dsp *dsp, int v) {
+  DspClock *c = &dsp->clk;
+  DspClockVoice *x = &c->v[v];
+  c->brrHeader = ram8(dsp, x->brrAdr);
+  c->brrData = ram8(dsp, (uint16_t)(x->brrAdr + x->brrOff));
+  brr_decode4(dsp, v);
+  if (x->brrOff >= 7) {
+    x->brrAdr = (c->brrHeader & 1) ? legacy_loop_adr(dsp, v) : (uint16_t)(x->brrAdr + 9);
+    x->brrOff = 1;
+  } else {
+    x->brrOff += 2;
+  }
+}
+
+void dsp_clockImportLegacy(Dsp *dsp) {
+  DspClock *c = &dsp->clk;
+  dsp_clockReset(dsp);
+  memcpy(c->regs, dsp->ram, sizeof(c->regs));
+  c->dir = c->regs[R_DIR];
+  c->non = c->regs[R_NON];
+  c->eon = c->regs[R_EON];
+  c->pmon = c->regs[R_PMON] & 0xfe;
+  c->kof = c->regs[R_KOF];
+  c->esa = c->regs[R_ESA];
+  c->everyOther = dsp->evenCycle ? 1 : 0;
+  c->counter = 0x77ff;
+  c->noise = (int32_t)((uint16_t)dsp->noiseSample & 0x7fff);
+  if (!c->noise) c->noise = 0x4000;
+  /* Echo: the old FIR ring holds the same half-scale samples; its index is
+   * the next slot to fill, the new one the last filled. */
+  for (int i = 0; i < 8; i++) {
+    c->echoHist[i][0] = dsp->firBufferL[i];
+    c->echoHist[i][1] = dsp->firBufferR[i];
+  }
+  c->echoHistPos = (uint8_t)((dsp->firBufferIndex + 7) & 7);
+  c->echoLen = (uint16_t)((c->regs[R_EDL] & 15) << 11);
+  c->echoOff = (uint16_t)(dsp->echoBufferIndex * 4);
+  if (c->echoLen && c->echoOff >= c->echoLen) c->echoOff = 0;
+  c->echoOn = dsp->echoWrites;
+  for (int v = 0; v < 8; v++) {
+    const DspChannel *ch = &dsp->channel[v];
+    DspClockVoice *x = &c->v[v];
+    static const uint8_t kMode[5] = { M_ATTACK, M_DECAY, M_SUSTAIN, M_SUSTAIN, M_RELEASE };
+    x->mode = kMode[ch->adsrState <= 4 ? ch->adsrState : 4];
+    x->env = ch->gain & 0x7ff;
+    x->envPrev = x->env;
+    x->envx = (uint8_t)(x->env >> 4);
+    if (ch->keyOn) c->konNew |= (uint8_t)(1 << v);   /* still to be polled */
+    int s = ch->pitchCounter >> 12, frac = ch->pitchCounter & 0xfff;
+    int w = s - 3;                         /* window start, in block samples */
+    int g0 = w >= 0 ? (w / 4) * 4 : -4;    /* its 4-sample group */
+    uint16_t cur = (uint16_t)(ch->decodeOffset - 9);
+    int first = g0 >= 4 ? 4 : g0;          /* the ring: samples first..first+11 */
+    for (int i = 0; i < 12; i++) {
+      int n = first + i;                   /* -4..15; -4 is never in a window */
+      int16_t smp = n >= -3 ? ch->decodeBuffer[n + 3] : ch->decodeBuffer[0];
+      x->buf[i] = (int16_t)(smp * 2);
+    }
+    x->bufPos = 0;
+    if (g0 >= 4) {
+      /* The ring ends at the block's last sample: the decoder continues with
+       * the next block, then catches up to the window's group. */
+      x->brrAdr = (ch->previousFlags & 1) ? legacy_loop_adr(dsp, v) : ch->decodeOffset;
+      x->brrOff = 1;
+      for (int k = 4; k < g0; k += 4) legacy_decode_group(dsp, v);
+    } else {
+      /* Still inside the current block: resume with its group after the ring. */
+      x->brrAdr = cur;
+      x->brrOff = (uint8_t)(1 + 2 * ((g0 + 12) / 4));
+    }
+    x->pos = ((w - g0) << 12) | frac;
+  }
+  memset(dsp->konDelay, 0, sizeof(dsp->konDelay));
+  memset(dsp->endPending, 0, sizeof(dsp->endPending));
+  dsp->rateCounter = 0x77ff;
+}
